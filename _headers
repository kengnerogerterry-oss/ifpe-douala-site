# [SÉCURITÉ] En-têtes HTTP (Netlify, Cloudflare Pages). Ignoré ailleurs : voir .htaccess pour Apache.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-jA7/HYOOzVuMak6NJkFyIQHruXzjOYBT2rO/OiNEGzY='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
